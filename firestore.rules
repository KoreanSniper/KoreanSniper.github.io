rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function verifiedGoogleUser() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == "google.com"
        && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email == "seoul2linejh@gmail.com";
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function profileValuesValid() {
      return request.resource.data.get("username", "") is string
        && request.resource.data.get("username", "").size() <= 24
        && request.resource.data.get("displayName", "") is string
        && request.resource.data.get("displayName", "").size() <= 100
        && request.resource.data.get("status", "") is string
        && request.resource.data.get("status", "").size() <= 120
        && request.resource.data.get("photoURL", "") is string
        && request.resource.data.get("photoURL", "").size() <= 1000
        && request.resource.data.get("provider", "google") == "google"
        && request.resource.data.get("emailVerified", true) == true;
    }

    function roomIsParticipant() {
      return signedIn()
        && (
          resource.data.hostId == request.auth.uid
          || resource.data.guestId == request.auth.uid
        );
    }

    function roomCommonFieldsValid() {
      return request.resource.data.keys().hasAll([
        "status",
        "hostId",
        "hostName",
        "createdAt",
        "updatedAt",
        "state"
      ])
      && request.resource.data.state is map
      && request.resource.data.hostId == resource.data.hostId
      && request.resource.data.hostName == resource.data.hostName
      && request.resource.data.createdAt == resource.data.createdAt;
    }

    function roomHostUpdateAllowed() {
      return signedIn()
        && request.auth.uid == resource.data.hostId
        && roomCommonFieldsValid()
        && request.resource.data.guestId == resource.data.guestId
        && request.resource.data.guestName == resource.data.guestName
        && request.resource.data.winner == resource.data.winner
        && request.resource.data.diff(resource.data).changedKeys()
          .hasOnly(["status", "updatedAt"])
        && (
          (
            resource.data.status == "waiting"
            && request.resource.data.status in ["waiting", "cancelled"]
          )
        );
    }

    function roomGuestJoinAllowed() {
      return signedIn()
        && resource.data.status == "waiting"
        && resource.data.guestId == null
        && request.resource.data.status == "active"
        && request.resource.data.guestId == request.auth.uid
        && request.resource.data.guestName is string
        && request.resource.data.hostId == resource.data.hostId
        && request.resource.data.hostName == resource.data.hostName
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).changedKeys()
          .hasOnly(["status", "guestId", "guestName", "updatedAt"]);
    }

    function roomActiveParticipantUpdateAllowed() {
      return signedIn()
        && resource.data.status == "active"
        && roomCommonFieldsValid()
        && request.resource.data.guestId == resource.data.guestId
        && request.resource.data.guestName == resource.data.guestName
        && (
          (
            request.resource.data.status == "active"
            && request.resource.data.winner == resource.data.winner
          )
          ||
          request.resource.data.status == "ended"
        )
        && request.resource.data.diff(resource.data).changedKeys()
          .hasOnly(["status", "state", "winner", "updatedAt"])
        && (
          request.auth.uid == resource.data.hostId
          || request.auth.uid == resource.data.guestId
        );
    }

    function roomDeleteAllowed() {
      return signedIn()
        && (
          request.auth.uid == resource.data.hostId
          || request.auth.uid == resource.data.guestId
          || isAdmin()
        );
    }

    function minigameRoomData(roomId) {
      return get(/databases/$(database)/documents/minigameRooms/$(roomId));
    }

    function minigameRoomParticipant(roomId) {
      return signedIn()
        && (
          minigameRoomData(roomId).data.hostId == request.auth.uid
          || minigameRoomData(roomId).data.guestId == request.auth.uid
        );
    }

    // =====================
    // PROFILES
    // =====================
    match /users/{userId} {
      allow read: if verifiedGoogleUser();

      allow create: if isAdmin()
        || (
          isOwner(userId) && verifiedGoogleUser() && profileValuesValid()
          && request.resource.data.keys().hasOnly([
            "username",
            "displayName",
            "photoURL",
            "status",
            "createdAt",
            "lastLoginAt",
            "provider",
            "emailVerified"
          ])
        );

      allow update: if isAdmin()
        || (
          isOwner(userId) && verifiedGoogleUser() && profileValuesValid()
          && request.resource.data.keys().hasOnly([
            "username",
            "displayName",
            "photoURL",
            "status",
            "createdAt",
            "lastLoginAt",
            "provider",
            "emailVerified"
          ])
        );

      allow delete: if (isOwner(userId) && verifiedGoogleUser()) || isAdmin();
    }

    // =====================
    // POSTS
    // =====================
    match /posts/{postId} {
      allow read: if true;

      allow create: if verifiedGoogleUser()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.content is string
        && request.resource.data.uid is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 120
        && request.resource.data.content.size() >= 1
        && request.resource.data.content.size() <= 10000
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly(["title", "content", "uid", "createdAt"]);

      allow update: if verifiedGoogleUser()
        && (resource.data.uid == request.auth.uid || isAdmin())
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 120
        && request.resource.data.content is string
        && request.resource.data.content.size() >= 1
        && request.resource.data.content.size() <= 10000
        && request.resource.data.diff(resource.data).changedKeys()
          .hasOnly(["title", "content", "updatedAt"]);

      allow delete: if verifiedGoogleUser()
        && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // =====================
    // COMMENTS
    // =====================
    match /comments/{commentId} {
      allow read: if true;

      allow create: if verifiedGoogleUser()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.postId is string
        && request.resource.data.content is string
        && request.resource.data.uid is string
        && request.resource.data.content.size() >= 1
        && request.resource.data.content.size() <= 2000
        && request.resource.data.likes == 0
        && request.resource.data.dislikes == 0
        && request.resource.data.created == request.time
        && exists(/databases/$(database)/documents/posts/$(request.resource.data.postId))
        && request.resource.data.keys().hasOnly(["postId", "content", "uid", "likes", "dislikes", "created"]);

      allow update: if false;

      allow delete: if verifiedGoogleUser()
        && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // =====================
    // POST LIKES
    // =====================
    match /likes/{likeId} {
      allow read: if verifiedGoogleUser()
        && (resource.data.uid == request.auth.uid || isAdmin());
      allow create, update, delete: if false;
    }

    // =====================
    // COMMENT LIKES
    // =====================
    match /comment_likes/{likeId} {
      allow read: if verifiedGoogleUser()
        && (resource.data.uid == request.auth.uid || isAdmin());
      allow create, update, delete: if false;
    }

    // =====================
    // POST REPORTS
    // =====================
    match /reports/{reportId} {
      allow read: if verifiedGoogleUser()
        && (resource.data.uid == request.auth.uid || isAdmin());

      allow create: if verifiedGoogleUser()
        && request.resource.data.uid == request.auth.uid
        && reportId == request.resource.data.postId + "_" + request.auth.uid
        && request.resource.data.keys().hasOnly(["postId", "uid", "reason", "type", "status", "createdAt"])
        && request.resource.data.postId is string
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 1
        && request.resource.data.reason.size() <= 500
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/posts/$(request.resource.data.postId))
        && request.resource.data.type == "post"
        && request.resource.data.status == "pending";

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).changedKeys()
          .hasOnly(["status", "reviewedAt", "reviewedBy"])
        && request.resource.data.status in ["resolved", "rejected"]
        && request.resource.data.reviewedBy == request.auth.uid;
      allow delete: if false;
    }

    // =====================
    // COMMENT REPORTS
    // =====================
    match /comment_reports/{reportId} {
      allow read: if verifiedGoogleUser()
        && (resource.data.uid == request.auth.uid || isAdmin());

      allow create: if verifiedGoogleUser()
        && request.resource.data.uid == request.auth.uid
        && reportId == request.resource.data.commentId + "_" + request.auth.uid
        && request.resource.data.keys().hasOnly(["commentId", "uid", "reason", "type", "status", "createdAt"])
        && request.resource.data.commentId is string
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 1
        && request.resource.data.reason.size() <= 500
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/comments/$(request.resource.data.commentId))
        && request.resource.data.type == "comment"
        && request.resource.data.status == "pending";

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).changedKeys()
          .hasOnly(["status", "reviewedAt", "reviewedBy"])
        && request.resource.data.status in ["resolved", "rejected"]
        && request.resource.data.reviewedBy == request.auth.uid;
      allow delete: if false;
    }

    // =====================
    // ACTIVITY / ADMIN AUDIT LOGS
    // =====================
    match /activity_logs/{logId} {
      allow read: if isAdmin();
      allow create: if false;
      allow update, delete: if false;
    }

    // =====================
    // PIXELFRONT ROOMS
    // =====================
    match /pixelfrontRooms/{roomCode} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update, delete: if false;
    }

    // =====================
    // MINIGAME ROOMS
    // =====================
    match /minigameRooms/{roomId} {
      allow read: if signedIn()
        && (
          resource.data.status == "waiting"
          || resource.data.hostId == request.auth.uid
          || resource.data.guestId == request.auth.uid
        );

      allow create: if signedIn()
        && request.resource.data.status == "waiting"
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.hostName is string
        && request.resource.data.state is map;

      allow update: if signedIn()
        && roomCommonFieldsValid()
        && (
          roomHostUpdateAllowed()
          || roomGuestJoinAllowed()
          || roomActiveParticipantUpdateAllowed()
        );

      allow delete: if roomDeleteAllowed();
    }

    // =====================
    // MINIGAME CHAT
    // =====================
    match /minigameRooms/{roomId}/chat/{messageId} {
      allow read: if minigameRoomParticipant(roomId);

      allow create: if minigameRoomParticipant(roomId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 180
        && request.resource.data.keys().hasAll(["uid", "name", "text", "clientTs", "createdAt"]);

      allow update, delete: if false;
    }

    // GOMOKU ROOMS
    // =====================
    match /gomokuRooms/{roomId} {
      allow read: if signedIn()
        && (
          resource.data.status == "waiting"
          || resource.data.hostId == request.auth.uid
          || resource.data.guestId == request.auth.uid
          || isAdmin()
        );

      allow create: if signedIn()
        && request.resource.data.status == "waiting"
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.hostName is string
        && request.resource.data.state is map;

      allow update: if signedIn()
        && roomCommonFieldsValid()
        && (
          roomHostUpdateAllowed()
          || roomGuestJoinAllowed()
          || roomActiveParticipantUpdateAllowed()
        );

      allow delete: if roomDeleteAllowed();
    }

    // =====================
    // GOMOKU MATCHMAKING
    // =====================
    match /gomokuMatchmaking/{docId} {
      allow read: if signedIn()
        && (request.auth.uid == resource.data.hostId || isAdmin());

      allow create: if signedIn()
        && request.auth.uid == request.resource.data.hostId
        && request.resource.data.keys().hasOnly(["roomId", "hostId", "updatedAt"])
        && request.resource.data.roomId is string;

      allow update: if signedIn()
        && request.auth.uid == resource.data.hostId
        && request.resource.data.hostId == resource.data.hostId
        && request.resource.data.roomId == resource.data.roomId
        && request.resource.data.keys().hasOnly(["roomId", "hostId", "updatedAt"]);

      allow delete: if signedIn()
        && (request.auth.uid == resource.data.hostId || isAdmin());
    }

    // =====================
    // GOMOKU CHAT
    // =====================
    match /gomokuRooms/{roomId}/chat/{messageId} {
      allow read: if signedIn()
        && (
          get(/databases/$(database)/documents/gomokuRooms/$(roomId)).data.status == "waiting"
          || get(/databases/$(database)/documents/gomokuRooms/$(roomId)).data.hostId == request.auth.uid
          || get(/databases/$(database)/documents/gomokuRooms/$(roomId)).data.guestId == request.auth.uid
          || isAdmin()
        );

      allow create: if signedIn()
        && (
          get(/databases/$(database)/documents/gomokuRooms/$(roomId)).data.status == "waiting"
          || get(/databases/$(database)/documents/gomokuRooms/$(roomId)).data.hostId == request.auth.uid
          || get(/databases/$(database)/documents/gomokuRooms/$(roomId)).data.guestId == request.auth.uid
          || isAdmin()
        )
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 180
        && request.resource.data.keys().hasAll(["uid", "name", "text", "clientTs", "createdAt"]);

      allow update, delete: if false;
    }

    // =====================
    // GOMOKU AI MEMORY
    // =====================
    match /gomokuAiMemory/{memoryId} {
      allow read, write: if isAdmin();
    }
  }
}
